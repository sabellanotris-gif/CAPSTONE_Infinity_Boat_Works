# Copy this file to `.env` and fill in the real values.
# NEVER commit the real `.env` (it contains secrets).

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Email — Brevo HTTPS API (recommended; works on Render where SMTP ports are blocked)
# Brevo → SMTP & API → API Keys (v3). Verify the sender address/domain first.
BREVO_API_KEY=xkeysib-your-key-here
EMAIL_FROM_ADDRESS=infintyboatsystem@gmail.com
EMAIL_FROM_NAME=Infinity Boat Works

# Email — Gmail SMTP (local fallback; only used when BREVO_API_KEY is empty)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=infintyboatsystem@gmail.com
EMAIL_PASS=your-app-password
EMAIL_SECURE=false

# Admin notification email
ADMIN_EMAIL=infintyboatsystem@gmail.com

# Server
PORT=3000
SERVER_URL=http://localhost:3000
